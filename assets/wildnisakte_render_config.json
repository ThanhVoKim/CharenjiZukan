{
  "project_id": "WildnisAkte",
  "description": "Default render configuration for WildnisAkte",
  "resolution": {
    "bypass_scale": false,
    "width": 1920,
    "height": 1080
  },
  "watermark_img": {
    "enabled": true,
    "path": "/content/assets/WildnisAkte-watermark.png",
    "x": "main_w-overlay_w-20",
    "y": "20",
    "width": "140"
  },
  "watermark_text": {
    "enabled": true,
    "text": "@WildnisAkte",
    "font_path": "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
    "fontsize": 36,
    "color": "white",
    "alpha": 0.6,
    "x": "10",
    "y": "h-th-10"
  },
  "black_strip": {
    "enabled": true,
    "scale_width": "1920",
    "scale_height": "80",
    "x": "0",
    "y": "962",
    "path": "/content/assets/black-background.jpg"
  },
  "subtitles": {
    "enabled": true,
    "burn_hardsub": true,
    "style": {
      "Fontname": "Liberation Sans",
      "Bold": "1",
      "FontSize": "16",
      "PrimaryColour": "&H0000FFFF",
      "OutlineColour": "&H00000000",
      "Outline": "1",
      "Shadow": "1.5",
      "BackColour": "0xE6000000",
      "Alignment": "2",
      "MarginV": "13"
    }
  },
  "audio_mix": {
    "non_voicevox_tts_volume": 1.7,
    "mute_audio_volume": 0.7,
    "ambient_volume": 0.04,
    "bgm_volume": 0
  },
  "audio_policies": {
    "global_bgm": "off",
    "mute_audio": "original",
    "ambient": "exclude_mute"
  },
  "audio_separator": {
    "mdxc_params": {
      "segment_size": 512,
      "overlap": 128,
      "batch_size": 16,
      "pitch_shift": 0
    }
  },
  "video_encoding": {
    "codec": "hevc_nvenc",
    "preset": "p4",
    "tune": "hq",
    "quality": [
      "-cq",
      "28"
    ],
    "note": "sync_video forces FFmpeg video render with -c:v hevc_nvenc -preset p4 -tune hq -cq 28"
  },
  "llm_metadata": {
    "enabled": false,
    "task_config": "config/llm_tasks/WildnisAkte_metadata.yaml",
    "input": {
      "write_debug_input": true,
      "debug_input_filename_template": "{video_stem}_metadata_input.txt"
    },
    "output": {
      "directory_policy": "/",
      "filename_template": "metadata.md"
    },
    "fail_policy": "warn"
  },
  "forced_alignment_subtitle": {
    "enabled": true,
    "language": "German",
    "max_chars": 42,
    "min_chars": 0,
    "split_on_comma": true,
    "offset_seconds": 0.04,
    "keep_tts_synced_debug": false,
    "fail_policy": "warn",
    "batch_size": 32
  }
}