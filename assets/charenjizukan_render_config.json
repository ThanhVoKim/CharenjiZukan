{
  "project_id": "CharenjiZukan",
  "description": "Default render configuration for CharenjiZukan",
  "resolution": {
    "bypass_scale": false,
    "width": 1920,
    "height": 1080
  },
  "watermark_img": {
    "enabled": true,
    "path": "/content/assets/CharenjiZukan-watermark.png",
    "x": "main_w-overlay_w-20",
    "y": "20"
  },
  "watermark_text": {
    "enabled": true,
    "text": "@CharenjiZukan",
    "font_path": "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
    "fontsize": 36,
    "color": "white",
    "alpha": 0.7,
    "x": "10",
    "y": "h-th-10"
  },
  "black_strip": {
    "enabled": true,
    "scale_width": "1920",
    "scale_height": "78",
    "x": "0",
    "y": "964",
    "path": "/content/assets/black-background.jpg"
  },
  "subtitles": {
    "enabled": true,
    "burn_hardsub": true,
    "style": {
      "Fontname": "Noto Sans CJK JP",
      "Bold": "1",
      "FontSize": "24",
      "PrimaryColour": "&H0000FFFF",
      "OutlineColour": "&H00000000",
      "Outline": "1",
      "Shadow": "1.5",
      "BackColour": "0xE6000000",
      "Alignment": "2",
      "MarginV": "10"
    }
  },
  "audio_mix": {
    "mute_audio_volume": 1.0,
    "ambient_volume": 0.05,
    "bgm_volume": 0
  },
  "audio_policies": {
    "global_bgm": "off",
    "mute_audio": "original",
    "ambient": "exclude_mute"
  },
  "audio_separator": {
    "mdxc_params": {
      "segment_size": 512,
      "overlap": 128,
      "batch_size": 16,
      "pitch_shift": 0
    }
  },
  "video_encoding": {
    "codec": "hevc_nvenc",
    "preset": "p4",
    "tune": "hq",
    "quality": [
      "-cq",
      "28"
    ],
    "note": "sync_video forces FFmpeg video render with -c:v hevc_nvenc -preset p4 -tune hq -cq 28"
  },
  "llm_metadata": {
    "enabled": false
  },
  "forced_alignment_subtitle": {
    "enabled": true,
    "language": "Japanese",
    "max_chars": 17,
    "min_chars": 0,
    "split_on_comma": true,
    "offset_seconds": 0.04,
    "keep_tts_synced_debug": false,
    "fail_policy": "warn",
    "batch_size": 32
  }
}