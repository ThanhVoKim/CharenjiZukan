{
  "project_id": "TheArmoryLog",
  "description": "Default render configuration for vertical video format",
  "resolution": {
    "bypass_scale": false,
    "width": 1080,
    "height": 1920
  },
  "watermark_img": {
    "enabled": true,
    "path": "/content/assets/TheArmoryLog20-watermark.png",
    "x": "main_w-overlay_w",
    "y": "main_h-overlay_h"
  },
  "watermark_text": {
    "enabled": true,
    "text": "@TheArmoryLog",
    "font_path": "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
    "fontsize": 46,
    "color": "white",
    "alpha": 0.8,
    "x": "10",
    "y": "h-th-10"
  },
  "audio_mix": {
    "non_voicevox_tts_volume": 1.65,
    "bgm_volume": 0.5
  },
  "audio_policies": {
    "global_bgm": "whole_video",
    "mute_audio": "silence",
    "ambient": "off"
  },
  "audio_separator": {
    "mdxc_params": {
      "segment_size": 512,
      "overlap": 128,
      "batch_size": 16,
      "pitch_shift": 0
    }
  },
  "video_encoding": {
    "codec": "hevc_nvenc",
    "preset": "p4",
    "tune": "hq",
    "quality": [
      "-cq",
      "28"
    ],
    "note": "sync_video forces FFmpeg video render with -c:v hevc_nvenc -preset p4 -tune hq -cq 28"
  },
  "llm_metadata": {
    "enabled": true,
    "task_config": "config/llm_tasks/seo_metadata.yaml",
    "input": {
      "write_debug_input": true,
      "debug_input_filename_template": "{video_stem}_metadata_input.txt"
    },
    "output": {
      "directory_policy": "/",
      "filename_template": "metadata.md"
    },
    "fail_policy": "warn"
  },
  "forced_alignment_subtitle": {
    "enabled": true,
    "language": "English",
    "max_chars": 42,
    "min_chars": 0,
    "split_on_comma": true,
    "offset_seconds": 0.24,
    "keep_tts_synced_debug": false,
    "fail_policy": "warn",
    "batch_size": 32
  }
}