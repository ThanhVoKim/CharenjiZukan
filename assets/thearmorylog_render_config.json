{
  "project_id": "TheArmoryLog",
  "description": "Default render configuration for vertical video format",
  "resolution": {
    "bypass_scale": false,
    "width": 1080,
    "height": 1920
  },
  "watermark_img": {
    "enabled": true,
    "path": "/content/assets/TheArmoryLog20-watermark.png",
    "x": "main_w-overlay_w",
    "y": "main_h-overlay_h"
  },
  "watermark_text": {
    "enabled": true,
    "text": "@TheArmoryLog",
    "font_path": "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
    "fontsize": 46,
    "color": "white",
    "alpha": 0.8,
    "x": "10",
    "y": "h-th-10"
  },
  "audio_mix": {
    "ambient_volume": 0.03,
    "bgm_volume": 0.5
  },
  "audio_separator": {
    "extract_bgm": true,
    "extract_vocals": false,
    "mdxc_params": {
      "segment_size": 512,
      "overlap": 128,
      "batch_size": 16,
      "pitch_shift": 0
    }
  },
  "video_encoding": {
    "preset": "p5",
    "quality": [
      "-cq",
      "23"
    ]
  },
  "llm_metadata": {
    "enabled": true,
    "task_config": "config/llm_tasks/seo_metadata.yaml",
    "input": {
      "write_debug_input": true,
      "debug_input_filename_template": "{video_stem}_metadata_input.txt"
    },
    "output": {
      "directory_policy": "/",
      "filename_template": "{video_stem}_metadata.md"
    },
    "fail_policy": "warn"
  }
}